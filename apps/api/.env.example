PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=file:./dev.db
JWT_SECRET=change-me-in-production

# ─── Analytics (@nubisco/analytics) ───────────────────────────────────────────
# Leave all three empty to disable server-side event emission. Browser pageviews
# are configured separately in apps/web/.env (VITE_ANALYTICS_URL).
ANALYTICS_URL=https://analytics.nubisco.io
ANALYTICS_TOKEN=
ANALYTICS_DOMAIN=verba.nubisco.io
