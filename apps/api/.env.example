PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=file:./dev.db
JWT_SECRET=change-me-in-production

# Instance operators (manage accounts): your own address in development.
VERBA_OPERATORS=you@example.com

# Customer AI keys are encrypted with a secret of their own. In development,
# opt in to a built-in one. In production set AI_ENCRYPTION_KEY instead
# (openssl rand -hex 32) and leave AI_DEV_SECRET unset.
AI_DEV_SECRET=true
# AI_ENCRYPTION_KEY=

# ─── Analytics (@nubisco/analytics) ───────────────────────────────────────────
# Leave all three empty to disable server-side event emission. Browser pageviews
# are configured separately in apps/web/.env (VITE_ANALYTICS_URL).
ANALYTICS_URL=https://analytics.nubisco.io
ANALYTICS_TOKEN=
ANALYTICS_DOMAIN=verba.nubisco.io
