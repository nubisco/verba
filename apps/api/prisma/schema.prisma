// The connection string lives in prisma.config.ts (CLI) and src/prisma.ts
// (runtime driver adapter), as Prisma 7 requires.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  passwordHash         String
  isGlobalAdmin        Boolean   @default(false) // cache of VERBA_OPERATORS, synced at sign-in
  createdAt            DateTime  @default(now())
  deactivatedAt        DateTime?
  preferredLocales     String    @default("[]") // JSON array of locale codes e.g. ["en","fr"]
  notificationOpenMode String    @default("inspector")
  // The Platform avatar: the OIDC `picture` claim, refreshed at every sign-in.
  // Null means no avatar, and the web app draws initials.
  avatarUrl            String?
  // The app-level `role` claim on the Platform token, refreshed at every
  // Platform sign-in. "admin" may create accounts (account.service.ts).
  // Null for a person who has never signed in through Platform.
  platformRole         String?

  memberships              Membership[]
  comments                 Comment[]
  translations             Translation[]
  auditLogs                AuditLog[]
  importRuns               ImportRun[]
  accountMemberships       AccountMember[]
  assignedTranslations     Translation[]  @relation("AssignedTranslations")
  notifications            Notification[] @relation("NotificationRecipient")
  triggeredNotifications   Notification[] @relation("NotificationActor")
}

// The tenant: an account holds projects, and its members are the people who
// may work in them. Every project belongs to exactly one account, and project
// access requires membership of both (acl.service.ts). Only people Platform
// marks as admins of this app create accounts. Owners add people.
model Account {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  projects Project[]
  members  AccountMember[]
}

// role: "OWNER" | "ADMIN" | "MEMBER" (types.ts AccountRole). An account always
// keeps at least one owner.
model AccountMember {
  id        String   @id @default(cuid())
  userId    String
  accountId String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([accountId])
}

model Project {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  avatar         String?  // Emoji or short icon text, e.g. "🌍" or "VP"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  accountId      String
  aiProvider     String?  // "openai" | "anthropic" | "gemini"
  aiApiKey       String?  // the project's own provider key, sealed by encryption.service.ts, never sent to a client
  aiModel        String?  // null means the fleet default for the provider (ai.service.ts DEFAULT_MODELS)
  aiEnabled      Boolean  @default(false)
  aiUpdatedAt    DateTime?

  account       Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  locales       Locale[]
  namespaces    Namespace[]
  keys          Key[]
  memberships    Membership[]
  auditLogs      AuditLog[]
  importRuns     ImportRun[]
  notifications  Notification[]
  xliffSkeletons XliffSkeleton[]
  aiUsage        AiUsage[]

  @@index([accountId])
}

model Locale {
  id        String  @id @default(cuid())
  projectId String
  code      String
  name      String
  isEnabled Boolean @default(true)

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  translations Translation[]

  @@unique([projectId, code])
}

model Namespace {
  id        String @id @default(cuid())
  projectId String
  name      String
  slug      String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keys    Key[]

  @@unique([projectId, slug])
}

model Key {
  id          String    @id @default(cuid())
  projectId   String
  namespaceId String
  name        String
  description String?
  deletedAt   DateTime?

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  namespace     Namespace      @relation(fields: [namespaceId], references: [id], onDelete: Cascade)
  translations  Translation[]
  notifications Notification[]

  @@unique([namespaceId, name])
}

model Translation {
  id           String    @id @default(cuid())
  keyId        String
  localeId     String
  text         String    @default("")
  status       String    @default("TODO")
  version      Int       @default(1)
  updatedById  String?
  assignedToId String?
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  key       Key     @relation(fields: [keyId], references: [id], onDelete: Cascade)
  locale    Locale  @relation(fields: [localeId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation(fields: [updatedById], references: [id])
  assignedTo User?  @relation("AssignedTranslations", fields: [assignedToId], references: [id])
  comments  Comment[]

  @@unique([keyId, localeId])
}

model Membership {
  id              String   @id @default(cuid())
  userId          String
  projectId       String
  role            String
  namespaces      String   @default("[]")
  assignedLocales String   @default("[]") // JSON array of locale IDs assigned to this member
  createdAt       DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Comment {
  id               String    @id @default(cuid())
  translationId    String
  userId           String
  text             String
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?
  parentId         String?
  mentionedUserIds String    @default("") // comma-separated user IDs

  translation   Translation    @relation(fields: [translationId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        Comment?       @relation("CommentReplies", fields: [parentId], references: [id])
  replies       Comment[]      @relation("CommentReplies")
  notifications Notification[]
}

model AuditLog {
  id         String   @id @default(cuid())
  projectId  String
  userId     String?
  action     String
  entityType String
  entityId   String
  before     String?
  after      String?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])
}

model ImportRun {
  id        String   @id @default(cuid())
  projectId String
  userId    String?
  status    String   @default("PENDING")
  mapping   String   @default("{}")
  stats     String   @default("{}")
  errors    String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])
}

// Instance-level record of operator grants and operator actions on accounts.
// Separate from AuditLog, which belongs to a project. No foreign keys, so the
// record outlives whatever it names.
model InstanceAuditLog {
  id           String   @id @default(cuid())
  actorId      String? // the operator who acted, or null when config made the change
  action       String // operator.granted | operator.revoked | user.deactivated | user.reactivated | user.deleted
  targetUserId String?
  detail       String? // JSON
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model OtpToken {
  id        String   @id @default(cuid())
  email     String
  code      String // SHA-256 of the code, never the code itself
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0) // wrong guesses so far; the code is burnt at OTP_MAX_ATTEMPTS
  createdAt DateTime @default(now())

  @@index([email])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String?
  type      String   // "MENTION" | "KEY_COMMENT"
  projectId String
  keyId     String
  commentId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?    @relation("NotificationActor", fields: [actorId], references: [id])
  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key     Key      @relation(fields: [keyId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id])
}

// ---------------------------------------------------------------------------
// EE: Billing, Entitlements, and License (SQLite-compatible, no native enums)
// ---------------------------------------------------------------------------

/// Active subscription for a managed-SaaS org.
/// planId: "free" | "pro" | "business" | "enterprise"
/// status: "trialing" | "active" | "past_due" | "canceled" | "paused" | "incomplete"
model Subscription {
  id                   String    @id @default(cuid())
  orgId                String    @unique
  planId               String    @default("free")
  status               String    @default("active")
  stripeSubscriptionId String?
  stripeCustomerId     String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

/// Manual entitlement override for a specific org.
/// features: JSON array of EntitlementFeature strings (replaces base if set).
/// featureAdditions: JSON array merged onto resolved features.
/// Limit fields: override specific resource limits (null = unlimited).
model EntitlementOverride {
  id                   String    @id @default(cuid())
  orgId                String    @unique
  features             String?   // JSON: EntitlementFeature[] | null
  featureAdditions     String?   // JSON: EntitlementFeature[] | null
  maxProjects          Int?
  maxSeatsPerProject   Int?
  maxKeysPerProject    Int?
  maxLocalesPerProject Int?
  maxMonthlyApiCalls   Int?
  note                 String?
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

/// Cached license state for a self-hosted EE instance.
/// One row per instance (singleton, orgId is optional for single-org installs).
/// status: "none" | "valid" | "grace" | "expired" | "invalid"
model LicenseState {
  id             String    @id @default(cuid())
  orgId          String?   @unique
  status         String    @default("none")
  licensee       String?
  planId         String?
  seats          Int?
  features       String    @default("[]") // JSON: EntitlementFeature[]
  expiresAt      DateTime?
  graceEndsAt    DateTime?
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Per-browser bag of platform identities the user has authenticated as in
// this browser. We never store platform tokens here — just enough metadata
// to render an account switcher and re-issue an OIDC authorize request with
// login_hint=<email> when the user switches. The bundleKey lives in a separate
// long-lived cookie. Only one identity per bundle is `active` at a time;
// the active row drives the local session token issuance.
model PlatformIdentity {
  id          String   @id @default(cuid())
  bundleKey   String
  platformSub String
  email       String
  name        String?
  lastUsedAt  DateTime @default(now())
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([bundleKey, platformSub])
  @@index([bundleKey])
}

/// Preserved original XLIFF document (skeleton) for lossless round-trip export.
/// One row per (project, target-language): re-importing a locale replaces it.
/// `document` holds the raw uploaded XLIFF text; export re-parses it and overlays
/// only changed <target> values + states, so untouched structure is byte-stable.
model XliffSkeleton {
  id             String   @id @default(cuid())
  projectId      String
  targetLanguage String
  sourceLanguage String
  version        String   @default("1.2")
  document       String // raw original XLIFF text
  originals      String   @default("[]") // JSON array of <file original> paths
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, targetLanguage])
}

/// One request that reached the project's AI provider, with the provider's own
/// token counts, for the usage and cost estimate in project settings.
model AiUsage {
  id           String   @id @default(cuid())
  projectId    String
  /// What asked: "suggest" (one key), "fill" (a locale filled from an import) or "preview" (settings).
  source       String
  provider     String
  model        String
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// The last good copy of LiteLLM's public price list, for the cost estimate.
/// Prices are fetched, never hard-coded (ai-prices.service.ts). A single row,
/// replaced on every successful fetch, so a restart reads it back instead of
/// fetching again and a failed fetch keeps the last copy that worked.
model AiPriceList {
  id        Int      @id
  /// JSON keyed "provider/model", USD per token.
  prices    String
  fetchedAt DateTime
}
