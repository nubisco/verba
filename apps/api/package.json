{
  "name": "@nubisco/verba-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:deploy": "node scripts/migrations.mjs deploy",
    "db:migration:new": "node scripts/migrations.mjs new",
    "db:migration:check": "node scripts/migrations.mjs check"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10",
    "@fastify/websocket": "^11.3.4",
    "@nubisco/verba-shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "prisma": "^7.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@nubisco/verba-ee": "workspace:*"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "tsx": "^4.21.0",
    "vitest": "^4.1.1"
  }
