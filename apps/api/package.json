{
  "name": "@nubisco/verba-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:deploy": "node scripts/migrations.mjs deploy",
    "db:migration:new": "node scripts/migrations.mjs new",
    "db:migration:check": "node scripts/migrations.mjs check",
    "db:d1:new": "node scripts/d1-migrations.mjs new",
    "db:d1:check": "node scripts/d1-migrations.mjs check"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.18",
    "@hono/node-ws": "^1.3.1",
    "@nubisco/verba-shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "fflate": "^0.8.2",
    "hono": "^4.13.16",
    "prisma": "^7.10.1",
    "proxy-addr": "^2.0.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@nubisco/verba-ee": "workspace:*"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/proxy-addr": "^2.0.3",
    "@types/ws": "^8.18.2",
    "tsx": "^4.21.0",
    "vitest": "^4.1.1",
    "ws": "^8.22.1"
  }
}
