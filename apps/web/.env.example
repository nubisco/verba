# ─── API ──────────────────────────────────────────────────────────────────────
# Backend API base URL
VITE_API_URL=http://localhost:4000

# ─── Error tracking ───────────────────────────────────────────────────────────
# Sentry DSN: leave empty to disable error reporting
VITE_SENTRY_DSN=

# ─── Analytics ────────────────────────────────────────────────────────────────
# @nubisco/analytics base URL (the tracker script is loaded from <url>/script.js
# and events are POSTed to <url>/collect). Leave empty to disable; analytics are
# also automatically disabled in development.
VITE_ANALYTICS_URL=https://analytics.nubisco.io
