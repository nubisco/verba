# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=verba
POSTGRES_PASSWORD=change-me
POSTGRES_DB=verba

# ─── API ──────────────────────────────────────────────────────────────────────
# Must be a long random string. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Origin of the web frontend (no trailing slash)
CORS_ORIGIN=https://verba.example.com

# ─── Web ──────────────────────────────────────────────────────────────────────
# Port the web frontend listens on (mapped to container 8080)
WEB_PORT=80

# ─── Email (optional, OTP codes logged to stdout if unset) ───────────────────
# Email goes through Resend (https://resend.com), the only transport. Without
# a key, sign-in codes are written to the API log instead.
# RESEND_API_KEY=re_xxxx

# Who sign-in codes come from. Required with RESEND_API_KEY, no default.
# MAIL_FROM="Verba <auth@example.com>"

# ─── AI keys ─────────────────────────────────────────────────────────────────
# Customers' own AI provider keys are encrypted at rest with this secret, and
# with nothing else: without it, saving an AI key is refused. Generate with:
# openssl rand -hex 32. Changing it makes every stored key unreadable, and each
# project must enter its key again.
AI_ENCRYPTION_KEY=

# ─── Instance operators ──────────────────────────────────────────────────────
# Who runs this instance: comma-separated emails. Operators manage accounts
# (Admin → Users). Nobody becomes one by signing up first, and the setup wizard
# only creates an account for an address listed here.
VERBA_OPERATORS=you@example.com

# ─── Sessions ────────────────────────────────────────────────────────────────
# How long a session lasts without use (an active one is renewed daily).
# SESSION_TTL_HOURS=168
# Session cookies are Secure in production. Set false only if this instance is
# served over plain HTTP, which leaves sessions readable on the network.
# COOKIE_SECURE=

# ─── Abuse limits ────────────────────────────────────────────────────────────
# Proxies whose X-Forwarded-For is believed when rate limiting by client
# address. Default: loopback, link-local and private ranges (the bundled nginx
# and a proxy on the same network). Only change it if your proxy reaches the API
# from a public address: list it here (comma separated addresses or CIDRs).
# TRUST_PROXY=
# Extra throwaway email domains refused for new accounts, comma separated
# BLOCKED_EMAIL_DOMAINS=

# ─── Auth mode ───────────────────────────────────────────────────────────────
# Set to true to enable password login (default: OTP only)
# ENABLE_LOCAL_PASSWORD=false
# Set to platform to sign in through the identity provider below only: no
# setup wizard, no email codes, no passwords, whatever the two settings above
# say. The first sign-in of an address in VERBA_OPERATORS creates its user and,
# on an empty database, the first account. Needs PLATFORM_ISSUER and
# PLATFORM_APP_ID (or OIDC_ISSUER). Unset keeps the wizard and local sign-in.
# VERBA_AUTH_MODE=platform
# The name of the first account, made by setup or by that first sign-in.
# VERBA_FIRST_ACCOUNT_NAME=My account

# ─── Nubisco Platform sign-in (optional) ─────────────────────────────────────
# Both are required together. PLATFORM_APP_ID is the slug your deployment is
# registered under in the Platform admin UI (Apps tab), and it is not the
# product name: Nubisco's own instance is registered as `nubisco-verba`.
# Setting only the issuer leaves the sign-in button hidden rather than sending
# an app id nobody has registered.
#
# The redirect URI registered for the app must be this instance's login route,
# e.g. https://verba.example.com/login
# PLATFORM_ISSUER=https://platform.nubisco.io
# PLATFORM_APP_ID=nubisco-verba
# Where the browser signs in and where the account switcher reads the
# signed-in accounts. Nubisco's Platform (Accord) keeps platform.nubisco.io as
# the token issuer and holds browser sessions on its auth host. Defaults to
# PLATFORM_ISSUER.
# PLATFORM_AUTH_ORIGIN=https://auth.nubisco.io

# ─── Your own identity provider (optional, Enterprise Edition) ───────────────
# Standard OpenID Connect against any compliant provider: Keycloak, Auth0,
# Okta, Microsoft Entra ID, Google Workspace. Everything but the issuer and
# the client is read from the provider's discovery document.
#
# Register this redirect URI with your provider:
#   https://verba.example.com/api/auth/sso/callback
#
# Requires LICENSE_KEY. Local one-time codes are never gated, so an
# unlicensed instance always has a way in.
# OIDC_ISSUER=https://keycloak.example.com/realms/acme
# OIDC_CLIENT_ID=verba
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=Acme SSO
# OIDC_AUTO_PROVISION=true

# ─── Hosted plans and billing (Enterprise Edition, Nubisco's hosted Verba) ───
# Leave all of these unset on a self-hosted instance: there are then no plans,
# no limits from billing and no billing page, exactly as before.
#
# Plans come from Nubisco's licenses service, which owns the Paddle
# subscriptions (Paddle is merchant of record). Verba never calls Paddle and
# holds no Paddle key. Plans switch on only with ENABLE_EE=true and both the
# URL and the service token set. See docs/plans-and-billing.md.
# ENABLE_EE=true
# VERBA_LICENSES_URL=https://licenses.nubisco.io
# The same value as SERVICE_TOKEN_VERBA in licenses. A secret: keep it out of
# tracked files.
# VERBA_LICENSES_SERVICE_TOKEN=
# The HMAC key licenses signs entitlement.updated with, the same value as
# ENTITLEMENT_WEBHOOK_SECRET_VERBA there. Unset, the webhook answers 404 and
# plans are only refreshed by fetching. In licenses, set
# ENTITLEMENT_WEBHOOK_URL_VERBA to https://verba.example.com/api/billing/entitlement
# VERBA_ENTITLEMENT_WEBHOOK_SECRET=
# Optional: where "Contact sales" on the billing page points.
# VERBA_SALES_URL=https://nubisco.io/contact?need=pre-sales
